# Copy to .env.local for dev. Never commit real values. Missing keys = stub mode.
APP_NAME=postslot
NEXT_PUBLIC_APP_URL=http://localhost:3000
# memory | mongo (defaults to mongo when MONGODB_URI is set)
DB_DRIVER=memory
MONGODB_URI=
MONGODB_DB=postslot
# >= 32 random chars, unique per app: openssl rand -base64 32
BETTER_AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# console | resend | smtp
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=
ALTCHA_HMAC_KEY=
# JSON of remote flags, e.g. {"payments_enabled":"on"}
APP_FLAGS=
# comma separated founder admin emails
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Ship path (M2) ---
# Bundle storage: memory (default when the R2 variables are absent) | fs | r2
BUNDLE_STORE=
BUNDLE_STORE_DIR=.data/bundles
R2_ACCOUNT_ID=
R2_BUCKET=hotrail-bundles
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public CDN host for bundle downloads (first level custom domain on the R2 bucket)
R2_PUBLIC_BASE=https://hotrail-cdn.buffersoltech.com
# Key encryption key for per-app signing keys: openssl rand -base64 32 (required in production)
SECRETS_KEK=
